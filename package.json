    "build:citizen": "npm run build --prefix citizen",
    "build:industries": "npm run build --prefix industries",
    "build:university": "npm run build --prefix university",
    "build:all": "npm run build:admin && npm run build:citizen && npm run build:industries && npm run build:university"
  },
  "dependencies": {
