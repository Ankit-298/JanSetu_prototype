  "description": "Societal Innovation Collaboration Portal - Problem Statement 2643 - Jharkhand",
  "main": "server.js",
  "workspaces": [
    "admin",
    "citizen",
    "industries",
    "university"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node others/seeds/seedData.js && node university/seed.js",
